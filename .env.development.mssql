# SichrPlace Frontend — Local MSSQL Backend
# ──────────────────────────────────────────
# Use this when running the Spring Boot backend locally with the
# local-mssql profile (Docker MSSQL on localhost:1433).
#
# The vanilla JS frontend reads config.js directly, so these vars
# serve as documentation. If migrating to Vite/Webpack, these
# become the actual .env file consumed by the build tool.
#
# Backend setup: see sichrplace-backend/docs/ENV_SETUP_GUIDE.MD

VITE_API_BASE_URL=http://localhost:8080
VITE_ENVIRONMENT=development

# Seed user credentials (shared with backend DataSeeder)
VITE_TEST_EMAIL=charlie.student@rwth-aachen.de
VITE_TEST_PASSWORD=password123

# Backend profile summary:
#   Spring profile:   local-mssql
#   Database:         MSSQL 2025 Developer (Docker, localhost:1433)
#   Seed data:        43 rows (6 users, 4 apartments, etc.)
#   Backend docs:     https://github.com/omer3kale/sichrplace-backend
