# SichrPlace Frontend — Beta MSSQL Backend (DigitalOcean Droplet)
# ────────────────────────────────────────────────────────────────
# Use this when pointing the frontend at the beta-mssql backend
# running on the DigitalOcean VPS (206.189.53.163).
# Caddy reverse proxy handles TLS → api.sichrplace.com.
#
# The vanilla JS frontend reads config.js directly, so these vars
# serve as documentation. If migrating to Vite/Webpack, these
# become the actual .env file consumed by the build tool.

VITE_API_BASE_URL=https://api.sichrplace.com
VITE_ENVIRONMENT=production

# Same seed users as local — DataSeeder produces identical data
VITE_TEST_EMAIL=charlie.student@rwth-aachen.de
VITE_TEST_PASSWORD=password123

# Backend profile summary:
#   Spring profile:   beta-mssql
#   Database:         MSSQL 2025 Developer (Docker, 206.189.53.163:1433)
#   Seed data:        43 rows (identical to local-mssql)
#   TLS:              Caddy auto-TLS on api.sichrplace.com
#   Backend docs:     https://github.com/omer3kale/sichrplace-backend
